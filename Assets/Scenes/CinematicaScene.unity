  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  dialogueText: {fileID: 1141014371}
  lines:
  - "Genial\u2026 el bal\xF3n ten\xEDa que acabar justo aqu\xED\u2026"
  - "Dicen que esta f\xE1brica cerr\xF3 porque un trabajador muri\xF3 aqu\xED dentro\u2026"
  - "Una m\xE1quina lo atrap\xF3 y nadie pudo sacarlo a tiempo\u2026"
  - "\xA1Ah\xED est\xE1 el bal\xF3n!"
  - Entro, lo cojo y me voy...
  - "R\xE1pido..."
  textSpeed: 0.07
